# Replace this placeholder with a local-only value in .env before starting Compose.
POSTGRES_PASSWORD=replace-with-local-only-password
# Optional trusted local OpenAI tiktoken vocabulary file. Without it token counts remain ESTIMATED.
Tokenizers__TiktokenVocabPath=
# Optional provider secret. Do not commit a real value; the configured hostname is allowlisted server-side.
Providers__OpenAICompatible__ApiKey=
# Optional server-side model override.
Providers__OpenAICompatible__Model=deepseek-v4.1-flash
